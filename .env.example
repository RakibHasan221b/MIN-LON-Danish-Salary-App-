# Optional. If unset, the API falls back to the free, keyless
# open.er-api.com provider automatically — currency conversion works
# without this. Set it only to use a keyed provider (currencyfreaks.com)
# instead. NEVER commit a real key here or anywhere in source control;
# this file only documents the variable name.
CURRENCY_API_KEY=

# Comma-separated list of frontend origins allowed to call this API from
# a browser (CORS). If unset, defaults to the local Next.js dev origins
# only (http://localhost:3000, http://127.0.0.1:3000), never a wildcard.
# For production, set this to your deployed Vercel URL(s), e.g.:
# CORS_ALLOWED_ORIGINS=https://min-loen.vercel.app,https://www.min-loen.dk
CORS_ALLOWED_ORIGINS=
